# Keep this project name unchanged when alternating between a NAS UI and the CLI.
COMPOSE_PROJECT_NAME=yt-playlist-archiver

# Run `id` on the destination host and use that user's numeric IDs.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Host paths. Relative paths are resolved from the directory containing compose.yaml.
CONFIG_DIR=./config
VIDEO_DIR=./media/videos
MUSIC_DIR=./media/music

# Dashboard access. Change this password before deployment.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_PASSWORD=admin1234

# The ytdl-sub container wakes every two minutes; /config/cron controls each group.
CRON_SCHEDULE="*/2 * * * *"
CRON_RUN_ON_START=false

# Optional Firefox control for private YouTube playlists.
# Run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
FIREFOX_CONFIG_DIR=./firefox
FIREFOX_BIND=0.0.0.0
FIREFOX_PORT=5800
FIREFOX_BROWSER_URL=http://raspberrypi.local:5800/
FIREFOX_CONTAINER_NAME=yt-playlist-archiver-firefox
